rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Solo se aceptan los campos del perfil, con su tipo y un largo razonable.
    function perfilValido(datos) {
      return datos.keys().hasOnly(['nombre', 'telefono'])
        && datos.nombre is string && datos.nombre.size() > 0 && datos.nombre.size() <= 60
        && datos.telefono is string && datos.telefono.size() <= 20;
    }

    // Perfil de cada usuario: solo el dueño de la cuenta puede leerlo o cambiarlo.
    match /users/{userId} {
      allow read, delete: if esDueno(userId);
      allow create, update: if esDueno(userId) && perfilValido(request.resource.data);
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
